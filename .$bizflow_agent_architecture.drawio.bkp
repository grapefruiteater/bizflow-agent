          <mxGeometry x="685" y="792" width="34" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p2-icon-lambda-approval-b" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#ED7100;strokeColor=#FFFFFF;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1105" y="792" width="34" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p2-icon-lambda-write-b" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#ED7100;strokeColor=#FFFFFF;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="1565" y="792" width="34" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p2-icon-ddb-b" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#C925D1;strokeColor=#FFFFFF;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="2240" y="792" width="34" height="34" as="geometry"/>
        </mxCell>

        <mxCell id="p2-step10" value="10  提案を確認&#xa;承認 / 却下" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D86613;strokeWidth=2;fontColor=#5A2A00;fontSize=13;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="110" y="930" width="190" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="p2-step9" value="9  Runtime応答を再検証&#xa;正常なproposed_actionsだけで&#xa;承認カードを自動生成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;fontColor=#3A1766;fontSize=12;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="420" y="830" width="290" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="p2-step11-bff" value="11  承認操作をBFFへ送信&#xa;CSRF header / identity / groupを検証&#xa;承認者だけがapprove / reject可能" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;fontColor=#3A1766;fontSize=12;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="420" y="985" width="290" height="98" as="geometry"/>
        </mxCell>
        <mxCell id="p2-step14-web" value="14  Dashboard / 実行履歴を表示&#xa;登録済みタスク数はBFF専用metricsで&#xa;DynamoDB GSIをCOUNT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;fontColor=#3A1766;fontSize=12;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="420" y="1135" width="290" height="88" as="geometry"/>
        </mxCell>
        <mxCell id="p2-step11-approval" value="11a  request_approval&#xa;11b  approve / reject / get_approval&#xa;承認状態と監査イベントを保存" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D86613;strokeWidth=2;fontColor=#5A2A00;fontSize=12;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="805" y="875" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="p2-reject" value="REJECTED&#xa;タスク登録なし&#xa;監査イベントのみ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#687078;fontColor=#232F3E;fontSize=12;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="805" y="1060" width="320" height="76" as="geometry"/>
        </mxCell>
        <mxCell id="p2-step12" value="12  BFFが承認データを再取得して直接呼出&#xa;Write Lambdaで再検証&#xa;・status = APPROVED&#xa;・proposal完全一致&#xa;・同一approval_idの冪等性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C62828;strokeWidth=2;fontColor=#7A1515;fontSize=12;fontStyle=1;align=left;spacingLeft=15;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="1225" y="875" width="360" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p2-write-boundary" value="モデル / Gatewayからは到達不可&#xa;IAM: ECS Task Role → 指定Lambdaのみ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4F4;strokeColor=#C62828;fontColor=#7A1515;fontSize=12;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="1225" y="1070" width="360" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="p2-step13-ddb" value="13  DynamoDBへ永続化&#xa;APPROVAL#... / APPROVAL&#xa;APPROVAL#... / EVENT#...&#xa;TASK#... / TASK&#xa;entity_type = TASK（GSI）" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=2;fontColor=#1D4D20;fontSize=12;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="1685" y="855" width="285" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p2-audit" value="監査履歴&#xa;APPROVAL_REQUESTED&#xa;APPROVED / REJECTED&#xa;TASK_REGISTERED&#xa;actor・時刻・task_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=2;fontColor=#1D4D20;fontSize=12;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="2010" y="855" width="270" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="p2-dashboard" value="Dashboard / History&#xa;未対応・緊急・期限超過&#xa;登録済みタスク数&#xa;承認者・作成タスク・イベント" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=2;fontColor=#1D4D20;fontSize=12;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="1810" y="1090" width="320" height="108" as="geometry"/>
        </mxCell>

        <mxCell id="p2-guardrails" value="実装済みガードレール" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232F3E;strokeColor=#232F3E;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;spacingLeft=18;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="30" y="1320" width="260" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="p2-guardrail-list" value="① Read / Write IAM分離　 ② Gatewayは4 Read toolsのみ　 ③ 承認をLambdaで強制　 ④ proposal完全一致と冪等性　 ⑤ Cognito利用者分離Memory　 ⑥ CloudWatch / 監査イベントで追跡" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#687078;fontColor=#232F3E;fontSize=13;align=left;spacingLeft=18;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="305" y="1320" width="2045" height="42" as="geometry"/>
        </mxCell>

