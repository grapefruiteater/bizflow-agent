        <mxCell id="p2-icon-cognito-b" value="" style="sketch=0;outlineConnect=0;gradientColor=none;fillColor=#DD344C;strokeColor=#FFFFFF;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1">
