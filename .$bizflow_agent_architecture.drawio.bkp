        <mxCell id="p2-step1" value="1  Cognitoでログイン&#xa;一般利用者 / 承認者" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#687078;strokeWidth=2;fontColor=#232F3E;fontSize=13;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="85" y="295" width="250" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="p2-step2" value="2  自然言語で依頼&#xa;「今週の問い合わせを分析…」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#687078;strokeWidth=2;fontColor=#232F3E;fontSize=13;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="85" y="450" width="250" height="78" as="geometry"/>
        </mxCell>
        <mxCell id="p2-step3" value="3  ALB/Cognito identityを検証&#xa;actorから不透明なsession ID / user IDを導出&#xa;生のCognito subはRuntimeへ渡さない" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;fontColor=#3A1766;fontSize=12;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="420" y="295" width="290" height="98" as="geometry"/>
        </mxCell>
        <mxCell id="p2-step4" value="4  InvokeAgentRuntime&#xa;Endpoint: PROD&#xa;prompt + runtimeSessionId + runtimeUserId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8C4FFF;strokeWidth=2;fontColor=#3A1766;fontSize=12;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="420" y="455" width="290" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="p2-step5" value="5  意図理解・処理計画&#xa;Strands Agent + Nova 2 Lite&#xa;選択可能なのはRead toolsのみ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;fontColor=#7A0A42;fontSize=13;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="805" y="295" width="320" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="p2-step8" value="8  構造化結果を返却&#xa;output_contract_version: 1.0&#xa;response + proposed_actions（最大5件）&#xa;write_operations_performed: false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;fontColor=#7A0A42;fontSize=12;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="805" y="470" width="320" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="p2-step6" value="6  AgentCore Gateway（MCP / IAM）&#xa;・get_business_requests&#xa;・analyze_request_data&#xa;・search_company_rules&#xa;・get_task_status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=2;fontColor=#1D4D20;fontSize=12;fontStyle=1;align=left;spacingLeft=15;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="1225" y="295" width="360" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="p2-read-note" value="create_business_taskは&#xa;schema / targetから削除済み" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4F4;strokeColor=#C62828;fontColor=#7A1515;fontSize=12;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="1225" y="490" width="360" height="64" as="geometry"/>
        </mxCell>
        <mxCell id="p2-s3-data" value="S3 架空業務データ&#xa;business_requests.csv&#xa;company_rules.md" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=2;fontColor=#1D4D20;fontSize=12;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
          <mxGeometry x="1685" y="295" width="185" height="104" as="geometry"/>
        </mxCell>
        <mxCell id="p2-ddb-read" value="DynamoDB&#xa;Task status / Audit&#xa;entity_type GSI" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFFFFF;strokeColor=#3F8624;strokeWidth=2;fontColor=#1D4D20;fontSize=12;fontStyle=1;fontFamily=Noto Sans JP;" vertex="1" parent="1">
